# Optional sanitizer support for development builds
option(CONTINUUM_LOB_ASAN "Enable AddressSanitizer" OFF)
option(CONTINUUM_LOB_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(CONTINUUM_LOB_TSAN "Enable ThreadSanitizer" OFF)

function(continuum_lob_enable_sanitizers target)
  if(CONTINUUM_LOB_ASAN)
    target_compile_options(${target} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
    target_link_options(${target} PRIVATE -fsanitize=address)
  endif()
  if(CONTINUUM_LOB_UBSAN)
    target_compile_options(${target} PRIVATE -fsanitize=undefined)
    target_link_options(${target} PRIVATE -fsanitize=undefined)
  endif()
  if(CONTINUUM_LOB_TSAN)
    target_compile_options(${target} PRIVATE -fsanitize=thread)
    target_link_options(${target} PRIVATE -fsanitize=thread)
  endif()
endfunction()
